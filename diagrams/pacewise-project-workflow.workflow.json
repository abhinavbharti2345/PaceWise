  "cards": [
    {
      "dot": "cyan",
      "title": "Dynamic Budget & Carry-Forward Engine",
      "items": [
        "Effective Total Budget = Initial Allowance + Added Inflow - Fixed Bills + Net Peer Cashflow",
        "Base Daily Pace = Effective Budget / Total Period Days",
        "Cumulative Carry-Forward Accumulator: Under-spending rolls forward as surplus; Over-spending recalculates future daily pace",
        "Today's Available = Dynamic Daily Limit + Cumulative Carry-Forward - Spent Today",
        "Forward-Allocated Adjustments: Mid-month bills and cash flows adjust remaining days without distorting past savings",
        "Month-End Rollover: Automatically carries forward unspent wallet cash into the next period's initial budget"
      ]
    },
    {
      "dot": "purple",
      "title": "Peer Debt & Unified Settlement Engine",
      "items": [
        "Dynamic Net Balance = Sum(Gave / Lent) - Sum(Took / Borrowed) - Sum(Bought For Me)",
        "Reciprocal Cash Flow Settlements: Settling creates an inverse cash transaction (took/gave) preserving true historical cash flow",
        "Itemized 'Paid for Me' Purchases: Tracked per-item; settling converts them into categorized expenses in your budget",
        "Debt Offset Settling: Offsets purchases directly against existing lent balance without moving physical wallet cash",
        "Unified Full Settlement: 1-click full settlement clears total net balance and marks all pending purchases as settled in one action"
      ]
    },
    {
      "dot": "emerald",
      "title": "Offline-First Resilience & Cloud Security",
      "items": [
        "Optimistic UI updates via Zustand store ensure 0ms latency for all transaction and settlement actions",
        "Synchronous user-scoped localStorage caching (pacewise-storage-${userId}) for resilient offline functionality",
        "Asynchronous Supabase PostgreSQL sync protected by strict Row Level Security (RLS) policies",
        "Clean multi-user isolation on shared devices: Logging out purges in-memory state and storage keys"
      ]
    }
  ]
